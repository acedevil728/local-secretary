<?xml version="1.0" encoding="UTF-8"?>
<!-- 운영(Mac mini): 부팅 시 자동 시작. 경로를 실제 위치로 바꾼 뒤
     cp deploy/macos/com.local-secretary.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.local-secretary.plist
     잠자기 끄기: sudo pmset -a sleep 0 disksleep 0 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local-secretary</string>
  <key>WorkingDirectory</key>
  <string>/Users/USER/local_secretary</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USER/local_secretary/.venv/bin/python</string>
    <string>-m</string>
    <string>app</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>APP_ENV</key>
    <string>prod</string>
    <key>PYTHONUTF8</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/USER/local_secretary/data/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USER/local_secretary/data/server.log</string>
</dict>
</plist>
