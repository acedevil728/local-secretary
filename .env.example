# 이 기기의 설정 예시. 복사해서 .env.local 을 만들고 값을 고친다.
#   Windows:  copy .env.example .env.local
#   macOS:    cp .env.example .env.local
# .env.local 은 git에 올라가지 않는다(.gitignore). 실제 주소·토큰·비밀번호는 .env.local 에만 둔다.
#
# 우선순위(뒤가 이긴다): 코드 기본값 < config/<APP_ENV>.env < .env.local < OS 환경 변수
# 형식: KEY=값 한 줄에 하나. 값 뒤에 주석을 붙이지 않는다. 비워 두거나 # 으로 막으면 기본값을 쓴다.

# ---- 실행 환경 ----
# dev  : 예시 데이터(.dev-data), 인증 끔
# prod : 운영 데이터(data/), 기기 토큰 인증 켬
APP_ENV=dev

# ---- 백엔드(FastAPI) ----
# 태블릿은 tailscale serve(HTTPS)로 들어오므로 보통 127.0.0.1로 둔다.
HOST=127.0.0.1
PORT=8000

# ---- 화면 개발 서버(Vite, start 스크립트가 함께 띄움) ----
# 이 PC에서만 열려면 127.0.0.1. start 스크립트의 -Lan / --lan 을 주면 모든 네트워크에서 열린다.
WEB_HOST=127.0.0.1
WEB_PORT=5173

# ---- 로컬 LLM (Ollama) ----
# 쉼표로 여러 노드. 순서대로 확인해 응답하는 첫 노드를 쓴다. "주소|모델"로 노드별 모델을 줄 수 있다.
# 예) Mac mini 먼저, 안 되면 Windows PC (Tailscale IP 또는 MagicDNS 이름):
# LLM_ENDPOINTS=http://100.64.0.10:11434|qwen2.5:14b-instruct,http://100.64.0.11:11434|qwen2.5:7b-instruct
LLM_ENDPOINTS=http://127.0.0.1:11434
# 노드에 모델을 안 적었을 때 쓰는 모델
LLM_MODEL=qwen2.5:7b-instruct
# LLM_TIMEOUT=120
# LLM_RETRY_SECONDS=60
# CONFIDENCE_THRESHOLD=0.75

# ---- 데이터·시간 ----
# DATA_DIR=data
# TIMEZONE=Asia/Seoul
# MORNING_TIME=07:30

# ---- 알림 채널 (쓰는 것만 채운다) ----
# ntfy: tailnet 안 자체 서버 권장
# NTFY_URL=http://ntfy.your-tailnet.ts.net
# 텔레그램: 알림 내용이 집 밖으로 나간다
# TELEGRAM_BOT_TOKEN=
# 이메일
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
